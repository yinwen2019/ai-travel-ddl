  "components": [
    {"name": "首页主入口", "kind": "button", "refersTo": "home-primary-action", "description": "首页 World 主入口，悬停使用深品牌色。", "html": "<a class=\"ds-home-primary\" href=\"#/world\">展开世界地图 <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a>", "css": ".ds-home-primary{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;min-height:48px;padding:12px 18px;border-radius:6px;color:var(--color-text-inverse);background:var(--color-text-primary);font-size:14px;font-weight:600;text-decoration:none;font-family:var(--font-sans);}.ds-home-primary:hover{background:var(--color-brand-dark)}.ds-home-primary:focus-visible{outline:2px solid var(--color-brand);outline-offset:3px;}@media(prefers-reduced-motion:no-preference){.ds-home-primary{transition:background-color 160ms ease-out}}"},
    {"name": "首页次入口", "kind": "button", "refersTo": "home-secondary-action", "description": "首页 Conference 次入口，保留底线和同页跳转。", "html": "<a class=\"ds-home-secondary\" href=\"#/conference\">查看会议 DDL</a>", "css": ".ds-home-secondary{display:inline-flex;align-items:center;min-height:48px;border-bottom:1px solid var(--color-border);color:var(--color-brand);font-size:14px;text-decoration:none;font-family:var(--font-sans);}.ds-home-secondary:hover{text-decoration:underline}.ds-home-secondary:focus-visible{outline:2px solid var(--color-brand);outline-offset:3px;}"},
    {"name": "工具按钮", "kind": "button", "refersTo": "control-button", "description": "工具栏按钮，展开时使用品牌浅底。", "html": "<button class=\"ds-control\" aria-expanded=\"false\">筛选会议</button>", "css": ".ds-control{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 14px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-surface);color:var(--color-text-primary);font-size:14px;font-weight:500;cursor:pointer;font-family:var(--font-sans);transition:background var(--transition-fast)}.ds-control:hover{background:var(--color-surface-hover)}.ds-control[aria-expanded=\"true\"]{color:var(--color-brand-dark);background:var(--color-brand-light);border-color:var(--color-brand)}.ds-control:focus-visible{outline:2px solid var(--color-brand);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-control{transition:none}}"},
    {"name": "搜索框", "kind": "input", "refersTo": "search-input", "description": "带本地 SVG 搜索图标的共享输入框。", "html": "<div class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input type=\"search\" aria-label=\"搜索会议名称、全称或分类\" placeholder=\"搜索会议…\"/></div>", "css": ".ds-search{position:relative;width:260px;max-width:100%;font-family:var(--font-sans);}.ds-search svg{position:absolute;left:12px;top:14px;color:var(--color-text-secondary);pointer-events:none}.ds-search input{box-sizing:border-box;width:100%;min-height:44px;padding:10px 44px 10px 36px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-surface);color:var(--color-text-primary);font-size:16px;caret-color:var(--color-brand);font-family:var(--font-sans);}.ds-search input::placeholder{color:var(--color-text-secondary)}.ds-search input:focus-visible{outline:2px solid var(--color-brand);outline-offset:3px;}"},
    {"name": "主导航", "kind": "nav", "refersTo": "nav-item", "description": "五项入口；当前项以品牌浅底强调。", "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><a href=\"#/\" aria-current=\"page\">Home</a><a href=\"#/world\">World</a><a href=\"#/conference\">Conference</a><a href=\"#/year\">Year</a><a href=\"#/cities\">City</a></nav>", "css": ".ds-nav{display:flex;align-items:center;gap:6px;font-family:var(--font-sans);}.ds-nav a{padding:10px 16px;min-height:44px;box-sizing:border-box;border-radius:8px;font-size:14px;color:var(--color-text-secondary);font-weight:600;white-space:nowrap;text-decoration:none}.ds-nav a:hover{background:var(--color-surface-secondary);color:var(--color-text-primary)}.ds-nav a[aria-current=\"page\"]{color:var(--color-brand-dark);background:var(--color-brand-light)}.ds-nav a:focus-visible{outline:2px solid var(--color-brand);outline-offset:3px;}@media(max-width:767px){.ds-nav{width:100%;gap:4px;padding-block:8px}.ds-nav a{flex:1;text-align:center;padding-inline:4px;font-size:13px}}"},
    {"name": "分类标签", "kind": "chip", "refersTo": "category-badge", "description": "中性标签保留名称与分类色点；示例为 AI 分类。", "html": "<span class=\"ds-badge\"><span class=\"ds-category-dot\" aria-hidden=\"true\"></span>AI 综合</span>", "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--color-border);border-radius:6px;padding:3px 7px;font-size:12px;line-height:1.4;font-weight:600;color:var(--color-text-secondary);white-space:nowrap;font-family:var(--font-sans);}.ds-category-dot{width:7px;height:7px;border-radius:50%;background:#3B82F6}"},
    {"name": "内容卡片", "kind": "card", "refersTo": "card", "description": "表面色与细边框形成平面层次，不以悬浮位移反馈。", "html": "<article class=\"ds-card\"><h3>会议届次</h3><a href=\"#/conference\">查看会议</a></article>", "css": ".ds-card{min-width:0;border:1px solid var(--color-border);border-radius:12px;padding:16px;background:var(--color-surface);color:var(--color-text-primary);font-family:var(--font-sans);}.ds-card h3{margin:0 0 12px;font-size:16px;font-weight:650;line-height:1.4}.ds-card a{display:inline-flex;align-items:center;min-height:44px;color:var(--color-brand);font-size:14px;text-decoration:none}.ds-card a:hover{text-decoration:underline}.ds-card a:focus-visible{outline:2px solid var(--color-brand);outline-offset:3px;}"}
  ],
  "narrative": {"northStar": "会议旅行地图册", "overview": "冷蓝灰画布、深墨蓝文字与细分隔线承托会议与城市资料。品牌保留单色折线地图标识；系统字体兼顾中文阅读与英文城市名称，信息密度随任务调整。\n\n地图带来旅行感，清晰的名称、日期、统计和入口承担操作。全站界面采用当前蓝色方向；世界视图的三维场景是独立的既有视觉系统，其地图材质颜色不从全站色表推导。", "keyCharacteristics": ["冷蓝灰底色与深墨蓝文字。", "细边框、平面层次与克制圆角。", "数据先行，品牌、分类和 DDL 各有独立语义。", "系统字体、清晰焦点和响应式阅读顺序。"], "rules": [{"name": "The Semantic Color Rule", "body": "品牌色、会议分类色、DDL 状态色和首页国家色分别表达不同信息；不因品牌换色而重映射业务颜色。DDL 指示与正文颜色沿用 `main.css` 的状态变量，会议分类沿用 `src/constants.ts`；首页国家色仅在首页榜单中使用。", "section": "colors"}], "dos": ["**Do** 沿用实际 CSS 变量与系统字体，深浅主题成对检查。", "**Do** 为交互保留可见焦点（2px 轮廓、3px 偏移）与普通入口至少（44px）的触控区域。", "**Do** 保留分类、DDL、国家色的文字说明与数据语义。"], "donts": ["**Don't** 把首页的背景地球、榜单或四入口布局推广为所有页面的模板。", "**Don't** 用全站冷蓝灰色替换世界三维场景的独立地图配色。", "**Don't** 给普通卡片增加悬浮位移，或为首页增加循环动画与远程字体依赖。"]}
}
