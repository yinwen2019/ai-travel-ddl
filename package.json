{
  "name": "ai-travel-ddl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "map:prepare": "node tools/build-globe-mesh.mjs",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate.mjs",
    "lint": "eslint . --ext .vue,.ts,.mjs --fix",
