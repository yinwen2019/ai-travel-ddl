  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "three-conic-polygon-geometry": "2.1.3",
